{
  "openapi": "3.1.0",
  "info": {
    "title": "Data Pipeline API",
    "description": "API para coleta, armazenamento e consulta de dados de conteúdo digital. Permite extrair comentários e informações de canais, além de consultar registros salvos no banco por filtros.",
    "version": "1.0.0"
  },
  "paths": {
    "/posts/youtube/hot": {
      "post": {
        "tags": [
          "Youtube"
        ],
        "summary": "Extrair vídeos em alta do YouTube",
        "description": "Busca os vídeos mais populares do YouTube e salva os dados no banco. Útil para monitorar tendências e coletar conteúdos em destaque.",
        "operationId": "youtube_hot_posts_youtube_hot_post",
        "parameters": [
          {
            "name": "max_videos",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Número máximo de vídeos a serem extraídos.",
              "examples": {
                "padrao": {
                  "summary": "Padrão",
                  "value": 5
                }
              },
              "default": 5,
              "title": "Max Videos"
            },
            "description": "Número máximo de vídeos a serem extraídos."
          },
          {
            "name": "max_comments",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 0,
              "description": "Número máximo de comentários a buscar por vídeo.",
              "examples": {
                "padrao": {
                  "summary": "Padrão",
                  "value": 5
                }
              },
              "default": 5,
              "title": "Max Comments"
            },
            "description": "Número máximo de comentários a buscar por vídeo."
          }
        ],
        "responses": {
          "200": {
            "description": "Extração concluída com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/YoutubeExtractionResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno durante a extração ou salvamento dos vídeos."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/posts/youtube/new": {
      "post": {
        "tags": [
          "Youtube"
        ],
        "summary": "Extrair vídeos recentes do YouTube",
        "description": "Busca vídeos recentes conforme uma consulta e intervalo de data informado. Pode ser usado para coletar conteúdo novo em um período específico.",
        "operationId": "youtube_new_posts_youtube_new_post",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Termo de busca usado para localizar vídeos no YouTube.",
              "examples": {
                "python": {
                  "summary": "Exemplo de busca",
                  "value": "python"
                }
              },
              "title": "Query"
            },
            "description": "Termo de busca usado para localizar vídeos no YouTube."
          },
          {
            "name": "published_after",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Data inicial no formato ISO 8601 para filtrar os vídeos.",
              "examples": {
                "exemplo": {
                  "summary": "Últimos 7 dias",
                  "value": "2025-01-01T00:00:00Z"
                }
              },
              "title": "Published After"
            },
            "description": "Data inicial no formato ISO 8601 para filtrar os vídeos."
          },
          {
            "name": "published_before",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Data final no formato ISO 8601 para filtrar os vídeos.",
              "examples": {
                "exemplo": {
                  "summary": "Até hoje",
                  "value": "2025-01-10T00:00:00Z"
                }
              },
              "title": "Published Before"
            },
            "description": "Data final no formato ISO 8601 para filtrar os vídeos."
          },
          {
            "name": "max_videos",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Número máximo de vídeos a serem recuperados.",
              "default": 5,
              "title": "Max Videos"
            },
            "description": "Número máximo de vídeos a serem recuperados."
          },
          {
            "name": "max_comments",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 0,
              "description": "Número máximo de comentários por vídeo.",
              "default": 5,
              "title": "Max Comments"
            },
            "description": "Número máximo de comentários por vídeo."
          }
        ],
        "responses": {
          "200": {
            "description": "Extração concluída com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/YoutubeExtractionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros inválidos ou consulta incompleta."
          },
          "500": {
            "description": "Erro durante a extração ou persistência dos dados."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/posts/youtube/channel": {
      "post": {
        "tags": [
          "Youtube"
        ],
        "summary": "Extrair vídeos de um canal do YouTube",
        "description": "Busca os vídeos de um canal específico e salva os conteúdos coletados no banco. Útil para monitorar canais favoritos ou competidores.",
        "operationId": "youtube_channel_posts_youtube_channel_post",
        "parameters": [
          {
            "name": "nome_canal",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Nome do canal do YouTube a ser consultado.",
              "examples": {
                "python": {
                  "summary": "Canal de exemplo",
                  "value": "Microsoft Developer"
                }
              },
              "title": "Nome Canal"
            },
            "description": "Nome do canal do YouTube a ser consultado."
          },
          {
            "name": "max_videos",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Número máximo de vídeos a recuperar do canal.",
              "default": 5,
              "title": "Max Videos"
            },
            "description": "Número máximo de vídeos a recuperar do canal."
          },
          {
            "name": "max_comments",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 0,
              "description": "Número máximo de comentários por vídeo.",
              "default": 5,
              "title": "Max Comments"
            },
            "description": "Número máximo de comentários por vídeo."
          }
        ],
        "responses": {
          "200": {
            "description": "Extração concluída com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/YoutubeExtractionResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro ao consultar o canal ou persistir os dados."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/posts/posts/filter": {
      "get": {
        "tags": [
          "Posts"
        ],
        "summary": "Buscar posts por filtros",
        "description": "Consulta posts armazenados no banco utilizando filtros enviados pela query string. É possível combinar múltiplos filtros para refinar a busca.",
        "operationId": "get_posts_by_columns_posts_posts_filter_get",
        "responses": {
          "200": {
            "description": "Lista de posts encontrada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostFilterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Nenhum filtro informado ou filtro inválido."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PostFilterResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Mensagem resumindo a consulta dos posts."
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total",
            "description": "Número total de registros retornados."
          },
          "data": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Data",
            "description": "Lista de posts encontrados conforme os filtros informados."
          }
        },
        "type": "object",
        "required": [
          "message",
          "total"
        ],
        "title": "PostFilterResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "YoutubeExtractionResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Mensagem resumindo o resultado da extração."
          },
          "posts_salvos": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Posts Salvos",
            "description": "Quantidade de posts armazenados na base após a operação."
          }
        },
        "type": "object",
        "required": [
          "message",
          "posts_salvos"
        ],
        "title": "YoutubeExtractionResponse"
      }
    }
  },
  "tags": [
    {
      "name": "Youtube",
      "description": "Endpoints para extração de vídeos, comentários e dados de canais do YouTube."
    },
    {
      "name": "Posts",
      "description": "Endpoints para consulta de posts salvos no banco conforme filtros específicos."
    }
  ]
}